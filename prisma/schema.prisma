// ToolHub database schema.
//
// Provider is SQLite, spoken through the libSQL driver adapter so the exact
// same code runs everywhere:
//   - Local / sandbox dev : DATABASE_URL=file:...  (plain SQLite file)
//   - Vercel production   : TURSO_DATABASE_URL=libsql://... (Turso, persists)
//
// A file-based database cannot persist on Vercel serverless, which is why
// production points at Turso (free tier, SQLite-compatible). The DATABASE_URL
// below is still used by the Prisma CLI (db push / migrate) locally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * Linked platforms — PWAs / websites the hub owner (admin) curates into the
 * App Store. Installing one adds a home-screen shortcut that opens the
 * platform in an embedded window; nothing is bundled locally.
 */
model ExternalApp {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  url         String
  description String
  tagline     String   @default("")
  category    String   @default("utilities")
  icon        String   @default("Globe")
  gradient    String   @default("from-emerald-400 via-teal-500 to-cyan-600")
  glow        String   @default("#10b981")
  developer   String   @default("Linked platform")
  keywords    String   @default("")
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, createdAt])
}

/**
 * D76/D77 Cloud Sync — optional per-account backup for signed-in users.
 *
 * One SyncAccount per email (created on first sign-in), holding SyncBlob
 * rows per data domain ('notes' | 'reminders' | 'launcher'). Payloads are
 * opaque JSON snapshots of the on-device stores — last write wins, nothing
 * is read server-side beyond (accountId, domain, rev, updatedAt).
 */
model SyncAccount {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String     @default("")
  provider  String     @default("credentials")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  blobs     SyncBlob[]

  @@index([email])
}

model SyncBlob {
  id        String      @id @default(cuid())
  accountId String
  domain    String
  payload   String
  rev       Int         @default(1)
  updatedAt DateTime    @updatedAt
  account   SyncAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, domain])
  @@index([accountId])
}
