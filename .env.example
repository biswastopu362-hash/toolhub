# ---------------------------------------------------------------------------
# ToolHub database configuration
# Copy this file to .env and pick ONE mode.
# ---------------------------------------------------------------------------

# MODE A — Local development (default, zero setup)
# Plain SQLite file, resolved by the libSQL driver adapter.
DATABASE_URL=file:./db/custom.db

# MODE B — Production (Vercel) / remote
# Create a free database at https://turso.tech then set BOTH vars here for
# local testing of the remote DB, or in Vercel → Settings → Environment
# Variables for production. When TURSO_DATABASE_URL is set it takes priority
# over DATABASE_URL.
#
# TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# Admin console passcode (Linked Platforms manager). Default: toolhub-admin
# ADMIN_PASSCODE=change-me

# ---------------------------------------------------------------------------
# Apply the schema:
#   Local : bun run db:push
#   Turso : TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... bun run db:turso
# ---------------------------------------------------------------------------
